# Server
PORT=5000
NODE_ENV=development

# Database — paste your MongoDB Atlas connection string here
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/khamar?retryWrites=true&w=majority
MONGODB_URI=

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins
# For dev: http://localhost:5173
# For prod: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173